# ---------------------------------------------------------------------------
# Sourcely — environment configuration
#
# Copy to `.env.local`. Never commit real secrets. Never prefix a secret with
# NEXT_PUBLIC_ — that inlines it into the browser bundle where anyone can read
# it.
#
# The application runs with none of the optional sections below configured. Each
# one degrades to a documented local behaviour rather than failing, and the
# admin settings page reports which are active.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Auth (REQUIRED in production) -----------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production start-up throws without this rather than silently signing sessions
# with a default — a predictable signing key is a total authentication bypass.
AUTH_SECRET=""
AUTH_SESSION_TTL_HOURS="72"

# --- Data driver -----------------------------------------------------------
# "memory"   zero-infrastructure driver, seeded catalogue, JSON-persisted writes.
#            Correct for one process; writes are lost if the file store is.
# "postgres" production driver (Prisma + PostgreSQL 16 + pgvector).
#            Requires DATABASE_URL, `npm run db:migrate` and `npm run db:seed`.
DATA_DRIVER="memory"
DATABASE_URL="postgresql://sourcely:sourcely@localhost:5432/sourcely?schema=public"

# --- AI provider -----------------------------------------------------------
# "offline"  deterministic NLU + lexical/vector ranking. No credentials needed,
#            and the ranking is identical either way — the model never scores,
#            filters or prices anything.
# "claude"   Anthropic Claude for intent parsing, explanations and summaries.
AI_PROVIDER="offline"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# --- Rate limiting ---------------------------------------------------------
# Without REDIS_URL, limits are counted in-process: correct for a single
# instance, but each replica behind a load balancer grants its own quota.
# With it, all instances draw on one bucket via an atomic Lua script.
REDIS_URL=""
RATE_LIMIT_AI_PER_MINUTE="20"
RATE_LIMIT_API_PER_MINUTE="120"
RATE_LIMIT_UPLOAD_PER_HOUR="40"

# --- Email -----------------------------------------------------------------
# Set RESEND_API_KEY *or* SMTP_URL. With neither, messages are written to the
# server log — including the password-reset link, so the flow stays testable —
# and the admin settings page reports mail as unconfigured.
#
# SMTP_URL form: smtps://user:pass@smtp.example.com:465  (implicit TLS)
#                smtp://user:pass@smtp.example.com:587   (STARTTLS)
# Percent-encode credentials containing @ / : or #.
RESEND_API_KEY=""
SMTP_URL=""
MAIL_FROM=""
MAIL_FROM_NAME="Sourcely"

# --- Uploads ---------------------------------------------------------------
# Two storage drivers, chosen like the data driver is:
#
# "local"  processed images under UPLOAD_DIR, streamed by the media route.
#          Correct wherever the filesystem is durable (development, a host
#          with a mounted volume). Deliberately outside `public/`: Next only
#          serves files from there that existed at build time, and a route
#          handler can state the content type instead of inferring it.
# "blob"   Vercel Blob object storage, required on serverless hosts where the
#          function filesystem is ephemeral. Needs BLOB_READ_WRITE_TOKEN
#          (Vercel dashboard → Storage → Blob → connect to the project).
#
# Unset, the driver is inferred: blob when BLOB_READ_WRITE_TOKEN is present,
# local otherwise. On Vercel the local driver refuses to start rather than
# accept uploads that vanish on the next deployment.
UPLOAD_DRIVER=""
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR=".data/uploads"

# --- Audit -----------------------------------------------------------------
# Salt for hashing client addresses in the audit trail. Addresses are never
# stored in the clear. Changing this breaks correlation with existing entries,
# which is the intended trade-off — set it once per environment.
AUDIT_IP_SALT=""

# ---------------------------------------------------------------------------
# Organisation details
#
# Every value below is rendered on the public site. All are optional and none
# has an invented fallback: an unset address is omitted and the footer says the
# deployment is a demonstration, rather than publishing a plausible-looking
# registered office that someone might act on.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_NAME="Sourcely"
NEXT_PUBLIC_LEGAL_NAME="Sourcely Commerce Technologies Pvt. Ltd."

NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_SALES_EMAIL=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_BUSINESS_HOURS="Mon–Sat, 9:30am – 7:00pm IST"

NEXT_PUBLIC_ADDRESS_LINE1=""
NEXT_PUBLIC_ADDRESS_LINE2=""
NEXT_PUBLIC_ADDRESS_CITY=""
NEXT_PUBLIC_ADDRESS_STATE=""
NEXT_PUBLIC_ADDRESS_PINCODE=""
NEXT_PUBLIC_ADDRESS_COUNTRY="India"

# Statutory identifiers. Shown in the footer only when set.
NEXT_PUBLIC_GSTIN=""
NEXT_PUBLIC_CIN=""

# Social links are omitted entirely when unset, rather than pointed at a
# platform home page.
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_X_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
