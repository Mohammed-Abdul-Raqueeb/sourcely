{
  "name": "sourcely",
  "version": "0.1.0",
  "private": true,
  "description": "Sourcely - AI-native B2B industrial product discovery and RFQ platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-search.ts",
    "smoke:auth": "tsx --conditions=react-server scripts/smoke-auth.ts",
    "smoke:all": "npm run smoke && npm run smoke:auth && npm run smoke:assistant && npm run smoke:admin",
    "smoke:assistant": "tsx --conditions=react-server scripts/smoke-assistant.ts",
    "mint-session": "tsx --conditions=react-server scripts/mint-session.ts",
    "smoke:admin": "tsx --conditions=react-server scripts/smoke-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run smoke:all",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "smoke:http": "tsx scripts/smoke-http.ts",
    "images:generate": "tsx scripts/generate-product-images.ts",
    "images:ingest": "tsx scripts/ingest-product-images.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "nodemailer": "^9.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.4",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "$postcss",
    "deepmerge-ts": "^8.0.2"
  }
}
